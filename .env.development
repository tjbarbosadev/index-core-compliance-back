# Override local — carregado por npm run dev / db:* (NODE_ENV=development)
# Postgres: docker run --name opcore-admin-postgres-local -e POSTGRES_DB=opcore \
#   -e POSTGRES_USER=opcore -e POSTGRES_PASSWORD=opcore -p 5433:5432 postgres:16

DATABASE_URL=postgresql://opcore:opcore@127.0.0.1:5433/opcore

PORT=3001
PUBLIC_API_URL=http://localhost:3001
STORAGE_PATH=./storage
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://admin.opcore.com.br,https://indexcore.com.br,https://www.indexcore.com.br,https://v2.indexcore.com.br
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=dev-secret-change-me-min-32-characters-local
NODE_ENV=development
PARTNER_TOKEN_GRACE_HOURS=24

RESEND_API_KEY=
EMAIL_FROM=OpCore <acesso@opcore.com.br>
WEB_URL=http://localhost:5173
EMAIL_DEBUG=1

AMORTIZATION_ALERT_ENABLED=1
TELEGRAM_BOT_TOKEN=<token>
AMORTIZATION_ALERT_TELEGRAM_CHAT_ID=<chat_id>

COMPLIANCE_API_URL=http://localhost:3010
COMPLIANCE_API_SERVICE_KEY=
COMPLIANCE_API_SUB=admin
COMPLIANCE_API_SERVICE=admin

# nextcorefim — documentos Mega (mesma API_SERVICE_KEY da API FIM; ajuste a porta se colidir)
NEXTCOREFIM_API_URL=http://localhost:3002
NEXTCOREFIM_API_SERVICE_KEY=
