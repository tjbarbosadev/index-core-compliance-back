DATABASE_URL=postgresql://opcore:opcore@localhost:5432/opcore

PORT=3001
PUBLIC_API_URL=http://localhost:3001
STORAGE_PATH=./storage
# Sites próprios (admin.opcore, IndexCore, localhost) — vírgula separada
CORS_ORIGINS=http://localhost:5173,https://admin.opcore.com.br
# Fallback legado (se CORS_ORIGINS vazio)
CORS_ORIGIN=http://localhost:5173
# Front público (links de e-mail). Se vazio, usa o primeiro CORS_ORIGINS
WEB_URL=http://localhost:5173
SESSION_SECRET=change-me-in-production-min-32-chars
NODE_ENV=development
# Grace period do token anterior após rotação (horas)
PARTNER_TOKEN_GRACE_HOURS=24

# Resend — deixe vazio em local; preencha no ambiente oficial
RESEND_API_KEY=
EMAIL_FROM=OpCore <noreply@opcore.com.br>
