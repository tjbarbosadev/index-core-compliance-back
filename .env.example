DATABASE_URL=postgresql://opcore:opcore@localhost:5432/opcore

PORT=3001
PUBLIC_API_URL=http://localhost:3001
STORAGE_PATH=./storage
# Sites próprios (admin.opcore, IndexCore, localhost) — vírgula separada
CORS_ORIGINS=http://localhost:5173,https://admin.opcore.com.br
# Fallback legado (se CORS_ORIGINS vazio)
CORS_ORIGIN=http://localhost:5173
# Front público (links de e-mail). OBRIGATÓRIO em produção:
# WEB_URL=https://admin.opcore.com.br
# Se WEB_URL for localhost com NODE_ENV=production, a API ignora e usa a 1ª origem não-local do CORS.
WEB_URL=http://localhost:5173
SESSION_SECRET=change-me-in-production-min-32-chars
NODE_ENV=development
# Grace period do token anterior após rotação (horas)
PARTNER_TOKEN_GRACE_HOURS=24

# Resend — obrigatório para esqueci senha / convite / token de parceiro
# 1) Crie a key em https://resend.com/api-keys
# 2) Verifique o domínio do EMAIL_FROM no painel Resend (ex.: opcore.com.br)
# 3) Em produção: WEB_URL=https://admin.opcore.com.br
# 4) Evite noreply@ — use um endereço que aceite resposta (ex.: acesso@)
RESEND_API_KEY=
EMAIL_FROM=OpCore <acesso@opcore.com.br>
# Em produção, defina 1 para logar o link de reset/convite quando o envio falhar
EMAIL_DEBUG=
