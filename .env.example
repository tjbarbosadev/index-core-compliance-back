# Copie para `.env` (oficial / servidor — gitignored).
# Em local, `npm run dev` e scripts `db:*` usam também `.env.development`
# (sobrescreve o `.env` quando NODE_ENV=development).
#
# Ver `.env.development` para defaults de localhost (:5433).

DATABASE_URL=postgresql://opcore:CHANGE_ME@opcore-admin-postgres:5432/opcore

PORT=3001
PUBLIC_API_URL=https://api.admin.opcore.com.br
STORAGE_PATH=./storage
# Sites próprios (admin.opcore, IndexCore, localhost) — vírgula separada
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://admin.opcore.com.br,https://indexcore.com.br,https://www.indexcore.com.br,https://v2.indexcore.com.br
CORS_ORIGIN=http://localhost:5173
# Front público (links de e-mail). OBRIGATÓRIO em produção:
WEB_URL=https://admin.opcore.com.br
SESSION_SECRET=change-me-in-production-min-32-chars
NODE_ENV=production
PARTNER_TOKEN_GRACE_HOURS=24

# Resend — obrigatório em produção para esqueci senha / convite / parceiro
RESEND_API_KEY=
EMAIL_FROM=OpCore <acesso@opcore.com.br>
EMAIL_DEBUG=

# Alerta amortização Sênior I (admin) — opcional; CI sem essas vars
# AMORTIZATION_ALERT_ENABLED=1
# TELEGRAM_BOT_TOKEN=
# AMORTIZATION_ALERT_TELEGRAM_CHAT_ID=
# AMORTIZATION_ALERT_EMAIL=
# WhatsApp via OpenWA (CRM crm_openwa na rede Docker caddy)
# OPENWA_BASE_URL=http://crm_openwa:2785
# OPENWA_API_KEY=
# OPENWA_SESSION_NAME=opcore-alerts
# OPENWA_SESSION_ID=
# AMORTIZATION_ALERT_WHATSAPP_TO=5511999999999,5511888888888

# Hub opcore-compliance (KYC/KYB) — mesma API_SERVICE_KEY do hub
COMPLIANCE_API_URL=https://api.compliance.opcore.com.br
COMPLIANCE_API_SERVICE_KEY=
COMPLIANCE_API_SUB=admin
COMPLIANCE_API_SERVICE=admin

# nextcorefim — documentos Mega do FIM (mesma API_SERVICE_KEY da API FIM)
NEXTCOREFIM_API_URL=http://localhost:3001
NEXTCOREFIM_API_SERVICE_KEY=

# Ingest de propostas Site FIDC/FIM → onboarding (X-API-Key em POST /internal/proposals)
# Mesma key nos sites: OPCORE_PROPOSAL_INGEST_SERVICE_KEY
PROPOSAL_INGEST_SERVICE_KEY=
