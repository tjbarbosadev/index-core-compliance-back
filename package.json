{
  "name": "indexcore-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "commit": "cz",
    "prepare": "husky",
    "db:migrate": "NODE_ENV=development prisma migrate dev",
    "db:push": "NODE_ENV=development prisma db push",
    "db:seed": "NODE_ENV=development tsx prisma/seed.ts",
    "db:backfill-yields": "NODE_ENV=development tsx prisma/backfill-yields.ts",
    "job:daily": "NODE_ENV=development tsx prisma/run-daily-job.ts",
    "partner:create": "NODE_ENV=development tsx prisma/partner-cli.ts create",
    "partner:rotate": "NODE_ENV=development tsx prisma/partner-cli.ts rotate",
    "partner:list": "NODE_ENV=development tsx prisma/partner-cli.ts list",
    "db:studio": "NODE_ENV=development prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@trpc/server": "^11.4.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.0",
    "pg": "^8.22.0",
    "resend": "^6.18.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.29.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.32",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prisma": "^7.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
