generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  active
  inactive
  suspended

  @@map("user_status")
}

enum PartyType {
  pf
  pj

  @@map("party_type")
}

enum PartyStatus {
  pendente
  aprovado
  rejeitado
  expirado
  revalidado
  excluido

  @@map("party_status")
}

enum RiskLevel {
  baixo
  medio
  alto
  muito_alto

  @@map("risk_level")
}

enum DocumentType {
  rg
  cpf
  cnh
  comprovante_residencia
  irpf
  extrato_bancario
  contrato_social
  alteracao_contratual
  procuracao
  declaracao
  balanco_patrimonial
  minuta_cessao
  outro

  @@map("document_type")
}

enum DocumentStatus {
  pendente
  em_analise
  aprovado
  rejeitado

  @@map("document_status")
}

enum ValidationMethod {
  manual
  ocr
  facial
  api

  @@map("validation_method")
}

enum FundModality {
  fidc
  fii
  fia
  fim
  fi_infra
  fip
  fi_debentures
  fiagro
  fi_rf
  fi_cambio

  @@map("fund_modality")
}

enum FundStatus {
  ativo
  inativo
  liquidacao
  encerrado

  @@map("fund_status")
}

enum QuotaType {
  senior
  senior_i
  senior_ii
  mezanino
  subordinada
  unica

  @@map("quota_type")
}

enum SelicSource {
  bacen
  fallback_db

  @@map("selic_source")
}

enum AmortizationKind {
  mensal
  final
  manual

  @@map("amortization_kind")
}

enum AmortizationAlertChannel {
  telegram
  whatsapp

  @@map("amortization_alert_channel")
}

enum AmortizationAlertDeliveryStatus {
  sent

  @@map("amortization_alert_delivery_status")
}

enum AssetClass {
  direito_creditorio
  acoes
  derivativos
  renda_fixa
  cotas_fundo_investimento
  imoveis
  outro

  @@map("asset_class")
}

enum ComplianceStatus {
  conforme
  alerta
  violacao

  @@map("compliance_status")
}

enum OnboardingStatus {
  em_andamento
  aprovado
  rejeitado
  expirado

  @@map("onboarding_status")
}

enum OnboardingKind {
  cotista
  cedente

  @@map("onboarding_kind")
}

enum StepStatus {
  pendente
  em_andamento
  concluido
  rejeitado

  @@map("step_status")
}

enum InvestorProfile {
  conservador
  moderado
  arrojado
  agressivo

  @@map("investor_profile")
}

enum AlertType {
  pagamento_picado
  transferencia_anomala
  retirada_acelerada
  cadastro_expirado
  documento_invalido
  lista_restritiva
  violacao_alocacao
  pep
  outro

  @@map("alert_type")
}

enum AlertSeverity {
  baixa
  media
  alta
  critica

  @@map("alert_severity")
}

enum AlertStatus {
  novo
  investigando
  reportado_coaf
  arquivado

  @@map("alert_status")
}

enum AuditResult {
  sucesso
  erro
  aviso

  @@map("audit_result")
}

// ============================================================================
// IDENTITY
// ============================================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  name         String     @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  isAdmin      Boolean    @default(false) @map("is_admin")
  mfaRequired  Boolean    @default(false) @map("mfa_required")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  mfaSecret    String?    @map("mfa_secret") @db.VarChar(255)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  permissionOverrides UserPermissionOverride[]
  auditLogs           AuditLog[]
  documentsUploaded   Document[]               @relation("DocumentUploader")
  documentsValidated  Document[]               @relation("DocumentValidator")
  kycReports          KycReport[]
  whatsappSession     WhatsappSession?

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  description String?
  module      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  menuItems     MenuItem[]
  userOverrides UserPermissionOverride[]

  @@map("permissions")
}

model MenuItem {
  id                   String  @id @default(uuid()) @db.Uuid
  key                  String  @unique @db.VarChar(100)
  label                String  @db.VarChar(100)
  route                String  @db.VarChar(255)
  icon                 String? @db.VarChar(50)
  parentId             String? @map("parent_id") @db.Uuid
  sortOrder            Int     @default(0) @map("sort_order") @db.SmallInt
  requiredPermissionId String  @map("required_permission_id") @db.Uuid
  active               Boolean @default(true)

  requiredPermission Permission @relation(fields: [requiredPermissionId], references: [id])
  parent             MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children           MenuItem[] @relation("MenuHierarchy")

  @@map("menu_items")
}

model UserPermissionOverride {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  granted      Boolean
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

// ============================================================================
// PARTIES & CADASTROS
// ============================================================================

model Party {
  id               String      @id @default(uuid()) @db.Uuid
  type             PartyType
  /** Unique only while deletedAt IS NULL (partial index in migration — LGPD soft delete). */
  cpfCnpj          String      @map("cpf_cnpj") @db.VarChar(18)
  legalName        String      @map("legal_name") @db.VarChar(500)
  status           PartyStatus @default(pendente)
  riskLevel        RiskLevel   @default(baixo) @map("risk_level")
  pepFlag          Boolean     @default(false) @map("pep_flag")
  approvedAt       DateTime?   @map("approved_at") @db.Timestamptz
  approvedBy       String?     @map("approved_by") @db.Uuid
  expiresAt        DateTime?   @map("expires_at") @db.Timestamptz
  /** Soft delete (LGPD) — listagens e unique ativo ignoram deletedAt != null */
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz
  deletedById      String?     @map("deleted_by_id") @db.Uuid
  /** nextcorefim Application.id — shared Mega folder for FIM KYC docs */
  fimApplicationId String?     @unique @map("fim_application_id") @db.VarChar(36)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  contacts           PartyContact[]
  bankAccounts       PartyBankAccount[]
  beneficialOwners   PartyBeneficialOwner[] @relation("PartyOwners")
  cotista            Cotista?
  cedente            Cedente?
  documents          Document[]
  partyFundLinks     PartyFundLink[]
  onboardingProcesses OnboardingProcess[]
  kycReports         KycReport[]

  @@index([status, expiresAt])
  @@index([cpfCnpj])
  @@index([deletedAt])
  @@map("parties")
}

model PartyContact {
  id          String   @id @default(uuid()) @db.Uuid
  partyId     String   @map("party_id") @db.Uuid
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  addressJson Json?    @map("address_json")
  isPrimary   Boolean  @default(true) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_contacts")
}

model PartyBankAccount {
  id          String    @id @default(uuid()) @db.Uuid
  partyId     String    @map("party_id") @db.Uuid
  bankCode    String    @map("bank_code") @db.VarChar(10)
  branch      String    @db.VarChar(10)
  account     String    @db.VarChar(20)
  accountType String?   @default("corrente") @map("account_type") @db.VarChar(20)
  isPrimary   Boolean   @default(false) @map("is_primary")
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, bankCode, branch, account])
  @@index([partyId])
  @@map("party_bank_accounts")
}

model PartyBeneficialOwner {
  id           String   @id @default(uuid()) @db.Uuid
  partyId      String   @map("party_id") @db.Uuid
  ownerName    String   @map("owner_name") @db.VarChar(255)
  ownerCpfCnpj String   @map("owner_cpf_cnpj") @db.VarChar(18)
  ownershipPct Decimal  @map("ownership_pct") @db.Decimal(5, 2)
  pepFlag      Boolean  @default(false) @map("pep_flag")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  party Party @relation("PartyOwners", fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_beneficial_owners")
}

model Cotista {
  id                String           @id @default(uuid()) @db.Uuid
  partyId           String           @unique @map("party_id") @db.Uuid
  investorProfile   InvestorProfile? @map("investor_profile")
  suitabilityResult InvestorProfile? @map("suitability_result")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("cotistas")
}

model Cedente {
  id                    String    @id @default(uuid()) @db.Uuid
  partyId               String    @unique @map("party_id") @db.Uuid
  juntaValidationStatus String    @default("pendente") @map("junta_validation_status") @db.VarChar(50)
  lastJuntaCheckAt      DateTime? @map("last_junta_check_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  investments FundInvestment[]

  @@map("cedentes")
}

// ============================================================================
// FUNDS
// ============================================================================

model Fund {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String       @db.VarChar(500)
  legalName            String?      @map("legal_name") @db.VarChar(500)
  cnpj                 String       @unique @db.VarChar(18)
  cvmCode              String?      @map("cvm_code") @db.VarChar(50)
  modality             FundModality
  targetAudience       String?      @map("target_audience") @db.VarChar(100)
  status               FundStatus   @default(ativo)
  inceptionDate        DateTime?    @map("inception_date") @db.Date
  website              String?      @db.VarChar(500)
  registeredAddress    String?      @map("registered_address") @db.VarChar(500)
  description          String?      @db.Text
  contactEmail         String?      @map("contact_email") @db.VarChar(255)
  contactPhone         String?      @map("contact_phone") @db.VarChar(50)
  regulatoryLimitsJson Json         @default("{}") @map("regulatory_limits_json")
  extraInfoJson        Json         @default("{}") @map("extra_info_json")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  netWorthHistory     FundNetWorthHistory[]
  partyFundLinks      PartyFundLink[]
  onboardingProcesses OnboardingProcess[]
  bankAccount         FundBankAccount?
  investments         FundInvestment[]
  transactions        FundTransaction[]

  @@map("funds")
}

model FundBankAccount {
  id          String   @id @default(uuid()) @db.Uuid
  fundId      String   @unique @map("fund_id") @db.Uuid
  bankCode    String   @map("bank_code") @db.VarChar(10)
  bankName    String?  @map("bank_name") @db.VarChar(100)
  branch      String   @db.VarChar(10)
  account     String   @db.VarChar(20)
  accountType String   @default("corrente") @map("account_type") @db.VarChar(20)
  pixKey      String?  @map("pix_key") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@map("fund_bank_accounts")
}

model FundNetWorthHistory {
  id            String   @id @default(uuid()) @db.Uuid
  fundId        String   @map("fund_id") @db.Uuid
  referenceDate DateTime @map("reference_date") @db.Date
  netWorth      Decimal  @map("net_worth") @db.Decimal(18, 2)
  source        String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, referenceDate])
  @@map("fund_net_worth_history")
}

model ComplianceRule {
  id                    String       @id @default(uuid()) @db.Uuid
  modality              FundModality
  assetClass            AssetClass   @map("asset_class")
  minPercentage         Decimal      @map("min_percentage") @db.Decimal(5, 2)
  warningThresholdPct   Decimal      @default(90) @map("warning_threshold_pct") @db.Decimal(5, 2)

  @@unique([modality, assetClass])
  @@map("compliance_rules")
}

model PartyFundLink {
  id                 String    @id @default(uuid()) @db.Uuid
  partyId            String    @map("party_id") @db.Uuid
  fundId             String    @map("fund_id") @db.Uuid
  quotaType          QuotaType @default(unica) @map("quota_type")
  quotaAmount        Decimal   @default(0) @map("quota_amount") @db.Decimal(18, 4)
  quotaCount         Int       @default(0) @map("quota_count")
  initialInvestment  Decimal   @default(0) @map("initial_investment") @db.Decimal(18, 2)
  currentPrincipal   Decimal   @default(0) @map("current_principal") @db.Decimal(18, 2)
  contractStartDate  DateTime? @map("contract_start_date") @db.Date
  contractEndDate    DateTime? @map("contract_end_date") @db.Date
  linkedAt           DateTime  @default(now()) @map("linked_at") @db.Timestamptz

  party          Party                 @relation(fields: [partyId], references: [id], onDelete: Cascade)
  fund           Fund                  @relation(fields: [fundId], references: [id], onDelete: Cascade)
  dailyYields    CotistaDailyYield[]
  amortizations  CotistaAmortization[]

  @@index([partyId])
  @@index([fundId])
  @@map("party_fund_links")
}

model SelicHistory {
  id         String      @id @default(uuid()) @db.Uuid
  date       DateTime    @unique @db.Date
  selicAnual Decimal     @map("selic_anual") @db.Decimal(6, 2)
  selicFator Decimal     @map("selic_fator") @db.Decimal(10, 6)
  source     SelicSource @default(bacen)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("selic_history")
}

model CotistaDailyYield {
  id                String      @id @default(uuid()) @db.Uuid
  partyFundLinkId   String      @map("party_fund_link_id") @db.Uuid
  referenceDate     DateTime    @map("reference_date") @db.Date
  selicPercent      Decimal     @map("selic_percent") @db.Decimal(6, 2)
  selicFactor       Decimal     @map("selic_factor") @db.Decimal(10, 6)
  selicSource       SelicSource @default(bacen) @map("selic_source")
  principal         Decimal     @db.Decimal(18, 2)
  yieldDay          Decimal     @map("yield_day") @db.Decimal(18, 2)
  yieldAccumulated  Decimal     @map("yield_accumulated") @db.Decimal(18, 2)
  balanceTotal      Decimal     @map("balance_total") @db.Decimal(18, 2)
  hadWithdraw       Boolean     @default(false) @map("had_withdraw")
  withdrawAmount    Decimal?    @map("withdraw_amount") @db.Decimal(18, 2)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  partyFundLink PartyFundLink @relation(fields: [partyFundLinkId], references: [id], onDelete: Cascade)

  @@unique([partyFundLinkId, referenceDate])
  @@index([referenceDate])
  @@map("cotista_daily_yields")
}

model CotistaAmortization {
  id              String           @id @default(uuid()) @db.Uuid
  partyFundLinkId String           @map("party_fund_link_id") @db.Uuid
  occurredOn      DateTime         @map("occurred_on") @db.Date
  amount          Decimal          @db.Decimal(18, 2)
  kind            AmortizationKind @default(mensal)
  periodStart     DateTime?        @map("period_start") @db.Date
  periodEnd       DateTime?        @map("period_end") @db.Date
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  partyFundLink PartyFundLink @relation(fields: [partyFundLinkId], references: [id], onDelete: Cascade)

  @@index([partyFundLinkId, occurredOn])
  @@map("cotista_amortizations")
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  partyId         String         @map("party_id") @db.Uuid
  type            DocumentType
  fileName        String         @default("") @map("file_name") @db.VarChar(255)
  fileUri         String         @map("file_uri")
  hashSha256      String         @default("") @map("hash_sha256") @db.VarChar(64)
  mimeType        String?        @map("mime_type") @db.VarChar(100)
  sizeBytes       Int?           @map("size_bytes")
  status          DocumentStatus @default(pendente)
  uploadedById    String?        @map("uploaded_by") @db.Uuid
  validatedById   String?        @map("validated_by") @db.Uuid
  validatedAt     DateTime?      @map("validated_at") @db.Timestamptz
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  party       Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  uploadedBy  User?  @relation("DocumentUploader", fields: [uploadedById], references: [id])
  validatedBy User?  @relation("DocumentValidator", fields: [validatedById], references: [id])
  validations DocumentValidation[]

  @@index([partyId])
  @@index([status])
  @@map("documents")
}

model DocumentValidation {
  id           String           @id @default(uuid()) @db.Uuid
  documentId   String           @map("document_id") @db.Uuid
  validatorId  String?          @map("validator_id") @db.Uuid
  method       ValidationMethod @default(manual)
  result       String           @db.VarChar(50)
  metadataJson Json?            @default("{}") @map("metadata_json")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_validations")
}

// ============================================================================
// ONBOARDING
// ============================================================================

model OnboardingProcess {
  id          String           @id @default(uuid()) @db.Uuid
  kind        OnboardingKind   @default(cotista)
  partyId     String           @map("party_id") @db.Uuid
  fundId      String           @map("fund_id") @db.Uuid
  quotaType   QuotaType?       @map("quota_type")
  currentStep Int              @default(1) @map("current_step") @db.SmallInt
  status      OnboardingStatus @default(em_andamento)
  stepDataJson Json?           @default("{}") @map("step_data_json")
  approvalJustification String? @map("approval_justification") @db.Text
  approvedById String?         @map("approved_by_id") @db.Uuid
  startedAt   DateTime         @default(now()) @map("started_at") @db.Timestamptz
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz
  completedAt DateTime?        @map("completed_at") @db.Timestamptz

  party               Party                @relation(fields: [partyId], references: [id])
  fund                Fund                 @relation(fields: [fundId], references: [id])
  steps               OnboardingStep[]
  suitabilityResponse SuitabilityResponse?
  kycReports          KycReport[]

  @@index([status])
  @@index([kind, status])
  @@map("onboarding_processes")
}

model OnboardingStep {
  id          String     @id @default(uuid()) @db.Uuid
  processId   String     @map("process_id") @db.Uuid
  stepNumber  Int        @map("step_number") @db.SmallInt
  status      StepStatus @default(pendente)
  completedBy String?    @map("completed_by") @db.Uuid
  completedAt DateTime?  @map("completed_at") @db.Timestamptz
  notes       String?

  process OnboardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([processId, stepNumber])
  @@map("onboarding_steps")
}

model SuitabilityResponse {
  id                String          @id @default(uuid()) @db.Uuid
  processId         String          @unique @map("process_id") @db.Uuid
  questionnaireJson Json            @map("questionnaire_json")
  resultProfile     InvestorProfile @map("result_profile")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  process OnboardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@map("suitability_responses")
}

// ============================================================================
// COMPLIANCE (MVP: PEP alerts)
// ============================================================================

model ComplianceAlert {
  id               String        @id @default(uuid()) @db.Uuid
  type             AlertType
  severity         AlertSeverity
  entityType       String?       @map("entity_type") @db.VarChar(100)
  entityId         String?       @map("entity_id") @db.Uuid
  status           AlertStatus   @default(novo)
  description      String?
  reportedToCoafAt DateTime?     @map("reported_to_coaf_at") @db.Timestamptz
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz
  createdById      String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, severity])
  @@map("compliance_alerts")
}

// ============================================================================
// KYC REPORTS (opcore-compliance hub)
// ============================================================================

model KycReport {
  id               String    @id @default(uuid()) @db.Uuid
  document         String    @db.VarChar(18)
  documentType     String    @map("document_type") @db.VarChar(4)
  partyId          String?   @map("party_id") @db.Uuid
  onboardingId     String?   @map("onboarding_id") @db.Uuid
  riskLevel        RiskLevel @map("risk_level")
  complianceStatus String    @map("compliance_status") @db.VarChar(40)
  blocked          Boolean   @default(false)
  dossierJson      Json      @map("dossier_json")
  reportHash       String    @map("report_hash") @db.VarChar(80)
  pdfUri           String?   @map("pdf_uri")
  createdById      String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  party      Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  onboarding OnboardingProcess? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  createdBy  User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([document])
  @@index([partyId])
  @@index([createdAt])
  @@map("kyc_reports")
}

// ============================================================================
// AUDIT
// ============================================================================

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     String      @db.VarChar(100)
  entityType String?     @map("entity_type") @db.VarChar(100)
  entityId   String?     @map("entity_id") @db.Uuid
  details    Json?       @default("{}")
  ipAddress  String?     @map("ip_address")
  result     AuditResult @default(sucesso)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// EXTERNAL PARTNERS (Bearer API)
// ============================================================================

model ApiPartner {
  id                      String    @id @default(uuid()) @db.Uuid
  name                    String    @unique @db.VarChar(100)
  email                   String    @db.VarChar(255)
  tokenHash               String    @map("token_hash") @db.VarChar(64)
  previousTokenHash       String?   @map("previous_token_hash") @db.VarChar(64)
  previousTokenValidUntil DateTime? @map("previous_token_valid_until") @db.Timestamptz
  rateLimitRpm            Int       @default(120) @map("rate_limit_rpm")
  active                  Boolean   @default(true)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt               DateTime? @map("rotated_at") @db.Timestamptz

  requestLogs ApiPartnerRequestLog[]

  @@index([tokenHash])
  @@index([previousTokenHash])
  @@index([email])
  @@map("api_partners")
}

model ApiPartnerRequestLog {
  id         String   @id @default(uuid()) @db.Uuid
  partnerId  String   @map("partner_id") @db.Uuid
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(512)
  statusCode Int      @map("status_code")
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  partner ApiPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt(sort: Desc)])
  @@map("api_partner_request_logs")
}

// ============================================================================
// AMORTIZATION ALERTS (admin notify)
// ============================================================================

model AmortizationAlertDelivery {
  id            String                          @id @default(uuid()) @db.Uuid
  referenceDate DateTime                        @map("reference_date") @db.Date
  channel       AmortizationAlertChannel
  /** Telegram: ''; WhatsApp: E.164 normalizado (ex. 5511...). */
  destination   String                          @default("") @db.Text
  /** d1_am | d1_pm | d0_am | d0_pm — idempotência por horário do lembrete. */
  slot          String                          @default("d1_am") @db.VarChar(16)
  status        AmortizationAlertDeliveryStatus @default(sent)
  createdAt     DateTime                        @default(now()) @map("created_at") @db.Timestamptz

  @@unique([referenceDate, channel, destination, slot])
  @@map("amortization_alert_deliveries")
}

model WhatsappSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  phone            String?   @db.VarChar(32)
  phoneNormalized  String?   @map("phone_normalized") @db.VarChar(20)
  openwaSessionId  String?   @map("openwa_session_id") @db.VarChar(64)
  status           String    @default("pending") @db.VarChar(32)
  connectedAt      DateTime? @map("connected_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([phoneNormalized])
  @@map("whatsapp_sessions")
}

// ============================================================================
// INVESTIDOS (fund portfolio assets)
// ============================================================================

enum InvestmentStatus {
  pendente
  aprovado
  cancelado

  @@map("investment_status")
}

enum TransactionType {
  aporte
  resgate
  amortizacao
  rendimento
  compra_ativo
  venda_ativo

  @@map("transaction_type")
}

enum TransactionCounterparty {
  cotista
  cedente
  fundo
  outro

  @@map("transaction_counterparty")
}

enum TransactionStatus {
  pendente
  aprovado
  estornado

  @@map("transaction_status")
}

model FundInvestment {
  id                     String           @id @default(uuid()) @db.Uuid
  fundId                 String           @map("fund_id") @db.Uuid
  assetClass             AssetClass       @map("asset_class")
  title                  String           @db.VarChar(500)
  amount                 Decimal          @db.Decimal(18, 2)
  justification          String           @db.Text
  cedenteId              String?          @map("cedente_id") @db.Uuid
  acquisitionDocumentUri String?          @map("acquisition_document_uri")
  paymentProofUri        String?          @map("payment_proof_uri")
  status                 InvestmentStatus @default(aprovado)
  acquiredAt             DateTime         @map("acquired_at") @db.Date
  createdById            String?          @map("created_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  fund    Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  cedente Cedente? @relation(fields: [cedenteId], references: [id], onDelete: SetNull)

  @@index([fundId, assetClass])
  @@index([cedenteId])
  @@map("fund_investments")
}

model FundTransaction {
  id                String                  @id @default(uuid()) @db.Uuid
  fundId            String                  @map("fund_id") @db.Uuid
  type              TransactionType
  counterpartyKind  TransactionCounterparty @map("counterparty_kind")
  partyId           String?                 @map("party_id") @db.Uuid
  amount            Decimal                 @db.Decimal(18, 2)
  signedAmount      Decimal                 @map("signed_amount") @db.Decimal(18, 2)
  description       String?                 @db.VarChar(500)
  proofUri          String?                 @map("proof_uri")
  status            TransactionStatus       @default(aprovado)
  occurredAt        DateTime                @map("occurred_at") @db.Timestamptz
  createdById       String?                 @map("created_by") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId, occurredAt])
  @@index([partyId])
  @@index([type, status])
  @@map("fund_transactions")
}
